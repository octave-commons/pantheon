{
  "name": "@promethean-os/pantheon",
  "version": "0.1.0",
  "description": "Pantheon Agent Management Framework — Complete framework with CLI, UI, and adapters",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "ava",
    "coverage": "c8 --config ./c8.config.json ava",
    "coverage:check": "c8 --config ./c8.config.json --check-coverage ava",
    "lint": "pnpm exec eslint .",
    "cli": "pnpm build && node dist/cli/index.js",
    "repl": "pnpm build && node dist/cli/index.js repl"
  },
  "dependencies": {
    "@openai/agents": "^0.1.9",
    "@promethean-os/pantheon-core": "workspace:*",
    "@promethean-os/pantheon-state": "workspace:*",
    "@promethean-os/pantheon-workflow": "workspace:*",
    "@promethean-os/pantheon-protocol": "workspace:*",
    "@promethean-os/pantheon-persistence": "workspace:*",
    "@promethean-os/pantheon-mcp": "workspace:*",
    "@promethean-os/pantheon-orchestrator": "workspace:*",
    "@promethean-os/pantheon-ecs": "workspace:*",
    "commander": "^11.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "ava": "^5.3.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@promethean-os/persistence": "workspace:*"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  }
}
